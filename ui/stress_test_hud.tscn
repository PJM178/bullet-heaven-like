[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/StressTestHud.cs" id="1_hud"]

[node name="StressTestHud" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
offset_right = 40.0
offset_bottom = 40.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 48

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Stats" type="Label" parent="Margin/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 28
text = "FPS"

[node name="Buttons" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="LessButton" type="Button" parent="Margin/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 80)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "-50"

[node name="MoreButton" type="Button" parent="Margin/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 80)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "+50"
